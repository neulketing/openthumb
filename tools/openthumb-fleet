#!/usr/bin/env bash
# openthumb-fleet — drive many OpenThumb devices from one host.
#
# Each debug build serves JSON-RPC on device-local 127.0.0.1:5321. That port is
# unreachable from the host, so we forward one host port per device and talk to
# all of them at once. adb is the only dependency besides curl and python3.
#
#   openthumb-fleet devices               list attached devices running OpenThumb
#   openthumb-fleet status                one status line per device
#   openthumb-fleet health                rpc reachability + sandbox + battery per device
#   openthumb-fleet call <method> [json]  raw JSON-RPC against every device
#   openthumb-fleet prompt "<text>"       send a prompt, print each device's sessionId
#   openthumb-fleet run "<text>"          prompt every device at once, then wait for
#                                         each; results land in $OPENTHUMB_FLEET_DIR/results/
#   openthumb-fleet collect <sessionId>   poll ONE session id across every device.
#                                         `prompt` hands back a different id per
#                                         device, so this is for a session you
#                                         dispatched yourself — `run` is the fleet path.
#   openthumb-fleet enqueue "<text>"      append a job to the queue
#   openthumb-fleet jobs                  list queued jobs
#   openthumb-fleet drain                 run queued jobs one at a time (see `run`)
#   openthumb-fleet provision             give every device the same provider +
#                                         model, so a fresh fleet can answer at all
#   openthumb-fleet cancel                stop in-flight runs
#
# Env: OPENTHUMB_PKG (default com.neulketing.openthumb)
#      OPENTHUMB_BASE_PORT (default 15321) — host ports are BASE+index
#      OPENTHUMB_TIMEOUT (default 30, seconds per call)
#      OPENTHUMB_WAIT_TIMEOUT (default 600, seconds for run/collect waits)
#      OPENTHUMB_FLEET_DIR (default ~/.openthumb/fleet) — queue + results
set -uo pipefail

PKG="${OPENTHUMB_PKG:-com.neulketing.openthumb}"
BASE_PORT="${OPENTHUMB_BASE_PORT:-15321}"
DEVICE_PORT=5321
FLEET_DIR="${OPENTHUMB_FLEET_DIR:-$HOME/.openthumb/fleet}"
QUEUE="$FLEET_DIR/queue.jsonl"
RESULTS_DIR="$FLEET_DIR/results"

command -v adb >/dev/null || { echo "openthumb-fleet: adb not found" >&2; exit 1; }

# Serials of attached devices that actually have the app installed. Devices in
# `unauthorized`/`offline` are skipped by matching only the `device` state.
# `adb shell` inherits stdin and will eat the rest of the serial list, so every
# adb call inside the loop is fed /dev/null — without it the loop stops after
# the first device.
fleet_serials() {
  adb devices | awk '$2 == "device" { print $1 }' | while read -r s; do
    adb -s "$s" shell pm list packages </dev/null 2>/dev/null \
      | tr -d '\r' | grep -q "^package:$PKG$" && echo "$s"
  done
}

# Forward a host port to the device's RPC port and echo the host port. Ports are
# derived from the index so repeat runs reuse the same mapping instead of
# leaking a new forward on every invocation.
ensure_forward() {
  # Two statements on purpose: bash expands every word of a `local` before
  # the builtin runs, so a port computed on the same line would read the
  # CALLER's `index`, not the one just assigned. It only works today because
  # every caller happens to name that variable `index`.
  local serial="$1" index="$2"
  local port=$((BASE_PORT + index))
  adb -s "$serial" forward "tcp:$port" "tcp:$DEVICE_PORT" >/dev/null 2>&1 || return 1
  echo "$port"
}

# Per-device auth token, cached for the run. The debug server requires it on
# every connection including loopback (a co-installed app can reach 127.0.0.1
# too, and this RPC exposes provider.export). `run-as` is the privilege adb
# has and such an app does not, so reading it here is the intended path.
# Cached on disk rather than in an associative array: macOS still ships bash
# 3.2, where `declare -A` does not exist and every lookup would then trip
# `set -u`.
# Reinstalling the app regenerates the token, so a cache that is only ever
# written goes stale into a permanent 401. `rpc` re-reads on Unauthorized by
# passing refresh=1.
device_token() {
  local serial="$1" refresh="${2:-}"
  local cache="$FLEET_DIR/tokens/$serial"
  if [ -z "$refresh" ] && [ -s "$cache" ]; then
    cat "$cache"
    return 0
  fi
  mkdir -p "$FLEET_DIR/tokens"
  # `</dev/null` for the same reason as in fleet_serials: this runs inside a
  # `while read serial` loop and adb would otherwise consume the rest of it,
  # silently truncating the fleet to the devices seen before the first cache miss.
  adb -s "$serial" shell run-as "$PKG" cat files/debug_server_token </dev/null 2>/dev/null \
    | tr -d '\r\n' > "$cache"
  cat "$cache"
}

# One JSON-RPC call. Prints the raw response body; empty means the app is not
# running, or is a release build (those ship no debug server at all).
rpc() {
  local port="$1" method="$2" params="${3:-}" serial="${4:-}"
  local body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$method\""
  [ -n "$params" ] && body="$body,\"params\":$params"
  body="$body}"
  local token="" resp=""
  [ -n "$serial" ] && token=$(device_token "$serial")
  resp=$(curl -s -m "${OPENTHUMB_TIMEOUT:-30}" "http://127.0.0.1:$port" \
    -H 'Content-Type: application/json' \
    ${token:+-H "X-Minis-Token: $token"} \
    -d "$body")
  # Stale cached token (the app was reinstalled): re-read it and retry once.
  if [ -n "$serial" ] && case "$resp" in *'"code":-32000'*Unauthorized*) true ;; *) false ;; esac; then
    token=$(device_token "$serial" refresh)
    resp=$(curl -s -m "${OPENTHUMB_TIMEOUT:-30}" "http://127.0.0.1:$port" \
      -H 'Content-Type: application/json' \
      ${token:+-H "X-Minis-Token: $token"} \
      -d "$body")
  fi
  printf '%s' "$resp"
}

format_status() {
  python3 -c '
import json,sys
try:
    r = json.load(sys.stdin)["result"]
except Exception:
    print("BAD RESPONSE"); sys.exit()
print("android=%s sdk=%s sandbox=%s device=%s" % (
    r.get("androidVersion","?"), r.get("sdkVersion","?"),
    "up" if r.get("prootBooted") else "down", r.get("device","?")))
'
}

# Run one method across the whole fleet, a line of output per device.
fleet_each() {
  local method="$1" params="${2:-}" fmt="${3:-raw}"
  local index=0 found=0 serial port resp
  while read -r serial; do
    [ -n "$serial" ] || continue
    found=1
    if ! port=$(ensure_forward "$serial" "$index"); then
      printf '%-24s ERROR    adb forward failed\n' "$serial"
      index=$((index + 1)); continue
    fi
    resp=$(rpc "$port" "$method" "$params" "$serial")
    if [ -z "$resp" ]; then
      printf '%-24s OFFLINE  no debug server on :%s (app stopped, or release build)\n' "$serial" "$port"
    else
      printf '%-24s ' "$serial"
      case "$fmt" in
        status) printf '%s\n' "$resp" | format_status ;;
        *)      printf '%s\n' "$resp" ;;
      esac
    fi
    index=$((index + 1))
  done < <(fleet_serials)
  [ "$found" -eq 1 ] || { echo "openthumb-fleet: no attached device has $PKG installed" >&2; return 1; }
}

# Health line per device: RPC reachability, appInfo, battery level/plugged.
# Battery comes from dumpsys over adb (no RPC needed), so a down debug server
# still yields a useful line.
fleet_health() {
  local index=0 found=0 serial port resp batt
  while read -r serial; do
    [ -n "$serial" ] || continue
    found=1
    batt=$(adb -s "$serial" shell dumpsys battery </dev/null 2>/dev/null | tr -d '\r')
    local level plugged
    level=$(printf '%s\n' "$batt" | awk -F': ' '/^\s*level:/ {print $2; exit}')
    plugged=$(printf '%s\n' "$batt" | awk -F': ' '/^\s*plugged:/ {print $2; exit}')
    local power="battery ${level:-?}%"
    [ "${plugged:-0}" != "0" ] && power="$power, charging"
    if ! port=$(ensure_forward "$serial" "$index"); then
      printf '%-24s rpc=down  %s (adb forward failed)\n' "$serial" "$power"
      index=$((index + 1)); continue
    fi
    resp=$(rpc "$port" debug.appInfo "" "$serial")
    if [ -z "$resp" ]; then
      printf '%-24s rpc=down  %s (app stopped, or release build)\n' "$serial" "$power"
    else
      printf '%-24s rpc=ok    %s %s\n' "$serial" "$power" "$(printf '%s\n' "$resp" | format_status)"
    fi
    index=$((index + 1))
  done < <(fleet_serials)
  [ "$found" -eq 1 ] || { echo "openthumb-fleet: no attached device has $PKG installed" >&2; return 1; }
}

# Give every device the same provider instance and model, so a fresh fleet can
# answer prompts without touching each phone's Settings by hand. Idempotent by
# label: a device that already has an instance with that label is left alone.
# The API key is read from the environment and never echoed.
fleet_provision() {
  local label="$1" ptype="$2" key="$3" baseurl="${4:-}" model="${5:-}"
  local index=0 found=0 serial port resp iid eid params
  while read -r serial; do
    [ -n "$serial" ] || continue
    found=1
    if ! port=$(ensure_forward "$serial" "$index"); then
      printf '%-24s ERROR    adb forward failed\n' "$serial"
      index=$((index + 1)); continue
    fi
    index=$((index + 1))
    resp=$(rpc "$port" provider.instances.list "" "$serial")
    if [ -z "$resp" ]; then
      printf '%-24s OFFLINE  no debug server (app stopped, or release build)\n' "$serial"
      continue
    fi
    if printf '%s' "$resp" | LABEL="$label" python3 -c '
import json,os,sys
label = os.environ["LABEL"]
try: xs = json.load(sys.stdin)["result"]["instances"]
except Exception: sys.exit(1)
sys.exit(0 if any(i.get("label") == label for i in xs) else 1)'; then
      printf '%-24s SKIP     already has "%s"\n' "$serial" "$label"
      continue
    fi
    params=$(LABEL="$label" PTYPE="$ptype" KEY="$key" BASEURL="$baseurl" \
      APPENDV1="${OPENTHUMB_PROVIDER_APPEND_V1:-}" python3 -c '
import json,os
p = {"providerType": os.environ["PTYPE"], "label": os.environ["LABEL"],
     "credentialType": "apiKey", "apiKey": os.environ["KEY"]}
if os.environ.get("BASEURL"):
    p["customBaseURL"] = os.environ["BASEURL"]
    p["seedBuiltInModels"] = False
    # A hand-written base URL is normally already complete; opt back in explicitly
    # for endpoints that really do want /v1 appended.
    p["appendV1Suffix"] = os.environ.get("APPENDV1") == "1"
print(json.dumps(p))')
    resp=$(rpc "$port" provider.instances.create "$params" "$serial")
    iid=$(printf '%s' "$resp" | python3 -c '
import json,sys
try: print(json.load(sys.stdin)["result"]["instance"]["id"])
except Exception: pass')
    if [ -z "$iid" ]; then
      printf '%-24s FAIL     create: %s\n' "$serial" "$(printf '%s' "$resp" | head -c 160)"
      continue
    fi
    if [ -z "$model" ]; then
      printf '%-24s OK       instance=%s\n' "$serial" "$iid"
      continue
    fi
    params=$(IID="$iid" MODEL="$model" python3 -c '
import json,os
print(json.dumps({"instanceId": os.environ["IID"], "modelId": os.environ["MODEL"]}))')
    resp=$(rpc "$port" provider.models.add "$params" "$serial")
    eid=$(printf '%s' "$resp" | python3 -c '
import json,sys
try:
    r = json.load(sys.stdin)["result"]
    print(r.get("id") or r.get("entryId") or r.get("entry",{}).get("id",""))
except Exception: pass')
    if [ -z "$eid" ]; then
      printf '%-24s PARTIAL  instance=%s model add failed: %s\n' \
        "$serial" "$iid" "$(printf '%s' "$resp" | head -c 120)"
      continue
    fi
    rpc "$port" provider.models.setAgentLoop \
      "$(EID="$eid" python3 -c 'import json,os; print(json.dumps({"entryId": os.environ["EID"], "inLoop": True}))')" \
      "$serial" >/dev/null
    printf '%-24s OK       instance=%s model=%s\n' "$serial" "$iid" "$model"
  done < <(fleet_serials)
  [ "$found" -eq 1 ] || { echo "openthumb-fleet: no attached device has $PKG installed" >&2; return 1; }
}

# chat.prompt on every device, one result file per device under
# results/<jobId>-<serial>.json, plus a one-line summary on stdout. $1 = prompt
# text, $2 = job id used in result filenames.
#
# Two phases, because a blocking `wait=true` per device would serialise the
# fleet: 16 phones × a ten-minute agent run is a 2h40m job for work the phones
# could all do at once. Phase 1 fires every prompt with wait=false so the whole
# fleet thinks simultaneously; phase 2 polls each device for *its own* session
# id. Wall-clock is then the slowest single device, not the sum.
fleet_run() {
  local text_json job_id="$2"
  text_json=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1")
  mkdir -p "$RESULTS_DIR"

  # Phase 1 — dispatch. `pending` accumulates "serial port sessionId" per device.
  local index=0 found=0 serial port resp sid pending=""
  while read -r serial; do
    [ -n "$serial" ] || continue
    found=1
    if ! port=$(ensure_forward "$serial" "$index"); then
      printf '%-24s ERROR    adb forward failed\n' "$serial"
      index=$((index + 1)); continue
    fi
    index=$((index + 1))
    resp=$(rpc "$port" chat.prompt "{\"prompt\":$text_json,\"wait\":false}" "$serial")
    if [ -z "$resp" ]; then
      printf '%-24s OFFLINE  no debug server (app stopped, or release build)\n' "$serial"
      continue
    fi
    sid=$(printf '%s' "$resp" | python3 -c '
import json,sys
try: print(json.load(sys.stdin)["result"]["sessionId"])
except Exception: pass')
    if [ -z "$sid" ]; then
      printf '%-24s ERROR    %s\n' "$serial" "$(printf '%s' "$resp" | head -c 120)"
      continue
    fi
    printf '%-24s dispatched %s\n' "$serial" "$sid"
    pending="$pending$serial $port $sid
"
  done < <(fleet_serials)
  [ "$found" -eq 1 ] || { echo "openthumb-fleet: no attached device has $PKG installed" >&2; return 1; }
  [ -n "$pending" ] || { echo "openthumb-fleet: nothing dispatched" >&2; return 1; }

  # Phase 2 — harvest. Each device is polled on the session it actually returned.
  #
  # `isRunning` alone is not enough to call a device done: right after an async
  # chat.prompt the tracker has not flipped to running yet, so the first poll
  # lands in the gap and harvests an empty transcript. A device counts as
  # finished only once it is idle AND has produced an assistant message; a run
  # that never produces one stays pending and is reported as a TIMEOUT rather
  # than as an empty success.
  local deadline=$((SECONDS + ${OPENTHUMB_WAIT_TIMEOUT:-600})) rc=0
  local still outfile tmpfile
  tmpfile="$RESULTS_DIR/.partial.$$"
  while [ -n "$pending" ] && [ $SECONDS -lt $deadline ]; do
    still=""
    while read -r serial port sid; do
      [ -n "$serial" ] || continue
      resp=$(rpc "$port" chat.session.status "{\"sessionId\":\"$sid\"}" "$serial")
      if printf '%s' "$resp" | python3 -c '
import json,sys
try: sys.exit(0 if json.load(sys.stdin)["result"]["isRunning"] else 1)
except Exception: sys.exit(1)'; then
        still="$still$serial $port $sid
"
        continue
      fi
      rpc "$port" chat.messages.list \
        "{\"sessionId\":\"$sid\",\"roles\":[\"assistant\"],\"includeTools\":false}" "$serial" \
        > "$tmpfile"
      if ! python3 -c '
import json,sys
try: sys.exit(0 if json.load(open(sys.argv[1]))["result"]["messages"] else 1)
except Exception: sys.exit(1)' "$tmpfile"; then
        still="$still$serial $port $sid
"                                  # idle but silent — it has not started yet
        continue
      fi
      outfile="$RESULTS_DIR/${job_id}-${serial}.json"
      mv "$tmpfile" "$outfile"
      printf '%-24s %s\n' "$serial" "$(python3 -c '
import json,sys
msgs = json.load(open(sys.argv[1]))["result"]["messages"]
print("done     %s" % (msgs[-1].get("content") or "").replace("\n", " ")[:80])' "$outfile")"
      printf '         → %s\n' "$outfile"
    done <<< "$pending"
    pending="$still"
    [ -n "$pending" ] && sleep 3
  done
  rm -f "$tmpfile"

  if [ -n "$pending" ]; then
    # Name what was dropped: a silent partial result reads as a full sweep.
    printf '%s' "$pending" | while read -r serial _ sid; do
      [ -n "$serial" ] && printf '%-24s TIMEOUT  still running %s\n' "$serial" "$sid"
    done
    rc=1
  fi
  return $rc
}

# Poll chat.session.status on every device until isRunning flips false.
fleet_collect() {
  local sid="$1" deadline=$((SECONDS + ${OPENTHUMB_WAIT_TIMEOUT:-600}))
  local pending
  pending=$(fleet_serials)
  [ -n "$pending" ] || { echo "openthumb-fleet: no attached device has $PKG installed" >&2; return 1; }
  local index=0 serial port resp running
  while [ $SECONDS -lt $deadline ]; do
    local still=0
    index=0
    while read -r serial; do
      [ -n "$serial" ] || continue
      port=$(ensure_forward "$serial" "$index") || { index=$((index + 1)); continue; }
      resp=$(rpc "$port" chat.session.status "{\"sessionId\":\"$sid\"}" "$serial")
      running=$(printf '%s\n' "$resp" | python3 -c '
import json,sys
try: print(json.load(sys.stdin).get("result",{}).get("isRunning"))
except Exception: print("?")
' 2>/dev/null)
      if [ "$running" = "True" ]; then
        still=1
      else
        printf '%-24s %s\n' "$serial" "$(printf '%s\n' "$resp" | python3 -c '
import json,sys
try:
    r = json.load(sys.stdin).get("result",{})
except Exception:
    print("BAD RESPONSE"); sys.exit()
print("done  %s" % (r.get("lastMessage") or "")[:80])
')"
      fi
      index=$((index + 1))
    done <<< "$pending"
    [ "$still" -eq 0 ] && return 0
    sleep 3
  done
  echo "openthumb-fleet: collect timed out — session still running somewhere" >&2
  return 1
}

### usage prints the header comment block — the range ends one line before `set -uo pipefail`.
usage() { sed -n "2,$(($(grep -n '^set -uo pipefail' "$0" | cut -d: -f1) - 1))p" "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  devices)
    n=0
    while read -r s; do [ -n "$s" ] && { echo "$s"; n=$((n + 1)); }; done < <(fleet_serials)
    echo "$n device(s) with $PKG" >&2
    ;;
  status) fleet_each debug.appInfo '' status ;;
  health) fleet_health ;;
  call)
    [ $# -ge 2 ] || { echo "usage: openthumb-fleet call <method> [params-json]" >&2; exit 1; }
    fleet_each "$2" "${3:-}"
    ;;
  prompt)
    [ $# -ge 2 ] || { echo "usage: openthumb-fleet prompt \"<text>\"" >&2; exit 1; }
    # wait=false so the fleet runs concurrently; harvest with `collect <sessionId>`.
    text=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$2")
    fleet_each chat.prompt "{\"prompt\":$text,\"wait\":false}" |
      python3 -c '
import json,sys
for line in sys.stdin:
    serial, _, rest = line.strip().partition(" ")
    try:
        r = json.loads(rest)
        sid = r.get("result",{}).get("sessionId") or r.get("error",{}).get("message","?")
    except Exception:
        sid = rest
    print("%-24s %s" % (serial, sid))
'
    ;;
  run)
    [ $# -ge 2 ] || { echo "usage: openthumb-fleet run \"<text>\"" >&2; exit 1; }
    fleet_run "$2" "$(date +%Y%m%d-%H%M%S)"
    ;;
  collect)
    [ $# -ge 2 ] || { echo "usage: openthumb-fleet collect <sessionId>" >&2; exit 1; }
    fleet_collect "$2"
    ;;
  enqueue)
    [ $# -ge 2 ] || { echo "usage: openthumb-fleet enqueue \"<text>\"" >&2; exit 1; }
    mkdir -p "$FLEET_DIR"
    python3 -c '
import json,sys,time,uuid
job = {"id": uuid.uuid4().hex[:8], "prompt": sys.argv[1], "enqueuedAt": int(time.time())}
with open(sys.argv[2], "a") as f: f.write(json.dumps(job) + "\n")
print("enqueued %s" % job["id"])
' "$2" "$QUEUE"
    ;;
  jobs)
    [ -f "$QUEUE" ] || { echo "(queue empty)"; exit 0; }
    python3 -c '
import json,sys,time
for line in open(sys.argv[1]):
    line = line.strip()
    if not line: continue
    j = json.loads(line)
    print("%s  %s  %s" % (j["id"], time.strftime("%Y-%m-%d %H:%M", time.localtime(j["enqueuedAt"])), j["prompt"]))
' "$QUEUE"
    ;;
  drain)
    [ -f "$QUEUE" ] || { echo "(queue empty)"; exit 0; }
    tmp="$QUEUE.draining"
    mv "$QUEUE" "$tmp"
    touch "$QUEUE"
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      job=$(printf '%s\n' "$line" | python3 -c 'import json,sys; j=json.loads(sys.stdin.read()); print(j["id"]); print(j["prompt"])')
      jid=$(printf '%s\n' "$job" | sed -n 1p)
      jprompt=$(printf '%s\n' "$job" | sed -n 2p)
      echo "── job $jid: $jprompt"
      if ! fleet_run "$jprompt" "$jid"; then
        echo "openthumb-fleet: job $jid failed — re-queued" >&2
        printf '%s\n' "$line" >> "$QUEUE"
      fi
    done < "$tmp"
    rm -f "$tmp"
    ;;
  provision)
    [ -n "${OPENTHUMB_PROVIDER_KEY:-}" ] || {
      cat >&2 <<'MSG'
usage: OPENTHUMB_PROVIDER_KEY=<api-key> openthumb-fleet provision
  OPENTHUMB_PROVIDER_KEY    required — API key, read from env so it never lands in shell history
  OPENTHUMB_PROVIDER_LABEL  default "fleet"
  OPENTHUMB_PROVIDER_TYPE   default "openAI" (see `openthumb-fleet call provider.types`)
  OPENTHUMB_PROVIDER_BASE   optional custom base URL; setting it disables built-in model seeding
  OPENTHUMB_PROVIDER_APPEND_V1  set to 1 to append /v1 to a custom base URL (default: no)
  OPENTHUMB_PROVIDER_MODEL  optional model id to add and expose to the agent loop
MSG
      exit 1
    }
    fleet_provision "${OPENTHUMB_PROVIDER_LABEL:-fleet}" "${OPENTHUMB_PROVIDER_TYPE:-openAI}" \
      "$OPENTHUMB_PROVIDER_KEY" "${OPENTHUMB_PROVIDER_BASE:-}" "${OPENTHUMB_PROVIDER_MODEL:-}"
    ;;
  cancel) fleet_each chat.session.cancel ;;
  ""|-h|--help|help) usage ;;
  *) echo "openthumb-fleet: unknown command '$1'" >&2; usage >&2; exit 1 ;;
esac
